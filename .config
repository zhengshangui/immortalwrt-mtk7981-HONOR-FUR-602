#==================== 插件配置（和diy‑part1配套）====================
# OpenClash 仅底层依赖，不编译luci-app-openclash
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_libnftables=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_jq=y

# OpenAppFilter
# CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ZeroTier
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=n

# WireGuard
# CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# SQM 队列
CONFIG_PACKAGE_sqm-scripts=y

# DDNS / FRP
# CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE-luci-app-frpc=y
# CONFIG_PACKAGE_luci-app-ddns-go=y

# MosDNS
# CONFIG_PACKAGE_luci-app-mosdns=y

# 测速
CONFIG_PACKAGE_luci-app-netspeedtest=y

# 其他工具
# CONFIG_PACKAGE_luci-app-openlist2=y
# CONFIG_PACKAGE-luci-app-partexp=y
# CONFIG_PACKAGE-luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-ttyd=y
# CONFIG_PACKAGE_luci-app-mwan3=y
# CONFIG_PACKAGE_luci-app-mwan3helper=y

# 通用依赖库
CONFIG_PACKAGE_libnetfilter-log=y
CONFIG_PACKAGE_libiptc=y
CONFIG_PACKAGE_libcares=y
CONFIG_PACKAGE_libevent2=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libwebsockets=y
CONFIG_PACKAGE_kmod-ipset=y
CONFIG_PACKAGE_kmod-nft-set=y
CONFIG_PACKAGE_kmod-nft-masq=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_liblucihttp-ucode=y
